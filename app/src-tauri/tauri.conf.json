{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tintin Player",
  "version": "0.1.0",
  "identifier": "dev.tintin.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tintin \u00b7 Prisoners of the Sun",
        "width": 640,
        "height": 640,
        "minWidth": 320,
        "minHeight": 400,
        "backgroundColor": "#09090b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost; media-src 'self' blob:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
